{
  "name": "unified-message",
  "version": "0.1.0",
  "description": "Normalize incoming Telegram, WhatsApp Cloud API, Instagram, Messenger and X webhooks into one message object, and verify each platform's webhook signature. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "keywords": [
    "webhook",
    "telegram",
    "whatsapp",
    "whatsapp-cloud-api",
    "instagram",
    "messenger",
    "twitter",
    "x",
    "normalize",
    "unified",
    "inbox",
    "hmac",
    "signature",
    "chatbot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pinlyx/unified-message.git"
  },
  "homepage": "https://github.com/Pinlyx/unified-message#readme",
  "bugs": {
    "url": "https://github.com/Pinlyx/unified-message/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
